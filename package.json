{
  "name": "english-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "e2e": "node scripts/e2e.mjs",
    "e2e:flows": "node scripts/e2e-flows.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:dedup-reviews": "tsx src/db/dedup-reviews.ts",
    "db:vocab": "tsx src/db/generate-vocabulary.ts",
    "db:vocab:frequency": "tsx src/db/generate-vocabulary-frequency.ts",
    "db:admin": "tsx src/db/create-admin.ts",
    "db:clean-junk": "tsx src/db/clean-junk-vocabulary.ts",
    "db:clean-junk:prod": "node --env-file=.env.production.local --import tsx src/db/clean-junk-vocabulary.ts",
    "db:calibration": "tsx src/db/calibration-report.ts",
    "db:calibration:prod": "node --env-file=.env.production.local --import tsx src/db/calibration-report.ts",
    "db:migrate:prod": "node --env-file=.env.production.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed:prod": "node --env-file=.env.production.local --import tsx src/db/seed.ts",
    "db:admin:prod": "node --env-file=.env.production.local --import tsx src/db/create-admin.ts"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@libsql/client": "^0.18.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.542.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
